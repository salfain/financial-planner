{
  "name": "financial-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:unit && npm run build:gas && npm run test:gas && npm run build",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:gas": "node scripts/smoke-gas-core.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "build:gas": "node scripts/build-gas-frontend.mjs",
    "build:mobile-api": "node scripts/build-mobile-api-package.mjs",
    "mobile:access-key": "node scripts/generate-mobile-access-key.mjs",
    "package:customer": "npm run build:gas && node scripts/build-customer-package.mjs && node scripts/verify-customer-package.mjs",
    "package:demo": "npm run build:gas && node scripts/build-demo-package.mjs",
    "license:keygen": "node scripts/generate-license-key.mjs",
    "license:issue": "node scripts/issue-license.mjs",
    "license:studio": "node scripts/license-studio.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14"
    }
  },
  "type": "module"
}
