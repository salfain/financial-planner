# Build variable: selects the VPS -> Apps Script transport in the browser.
NEXT_PUBLIC_FINANCE_BACKEND=apps-script

# Runtime-only variables: keep these out of the client bundle.
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
APPS_SCRIPT_ACCESS_KEY=vfp_replace_with_the_generated_private_key
